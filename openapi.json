{
  "openapi": "3.1.0",
  "info": {
    "title": "Intervals Connector",
    "version": "1.0.0",
    "description": "Proxy for Intervals.icu API"
  },
  "servers": [
    {
      "url": "https://intervals-connector.onrender.com/",
      "description": "Render deployment base URL"
    }
  ],
  "paths": {
    "/intervals": {
      "post": {
        "operationId": "proxyIntervals",
        "summary": "Forward requests to Intervals.icu API",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "example": "GET"
                  },
                  "path": {
                    "type": "string",
                    "example": "events?oldest=2025-10-17&newest=2025-10-17"
                  },
                  "body": {
                    "type": "object"
                  }
                },
                "required": ["method", "path"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response from Intervals.icu API"
          }
        }
      }
    }
  },
  "components": {}
}
